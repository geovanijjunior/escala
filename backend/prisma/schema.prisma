generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model users {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String?
  raw_user_meta_data Json?   @default("{}")

  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alocacoes {
  id             BigInt        @id @default(autoincrement())
  conta_id       String        @db.Uuid
  geracao_id     BigInt
  colaborador_id BigInt
  data           DateTime      @db.Date
  modalidade     String
  unidade_id     BigInt?
  travado        Boolean       @default(false)
  posto_id       BigInt?
  colaboradores  colaboradores @relation(fields: [colaborador_id, conta_id], references: [id, conta_id], onDelete: Cascade, onUpdate: NoAction, map: "alocacoes_colaborador_id_conta_fkey")
  contas         contas        @relation(fields: [conta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  geracoes       geracoes      @relation(fields: [geracao_id, conta_id], references: [id, conta_id], onDelete: Cascade, onUpdate: NoAction, map: "alocacoes_geracao_id_conta_fkey")
  postos         postos?       @relation(fields: [posto_id, conta_id], references: [id, conta_id], onDelete: SetNull, onUpdate: NoAction, map: "alocacoes_posto_id_conta_fkey")
  unidades       unidades?     @relation(fields: [unidade_id, conta_id], references: [id, conta_id], onUpdate: NoAction, map: "alocacoes_unidade_id_conta_fkey")

  @@unique([geracao_id, colaborador_id, data])
  @@index([colaborador_id, data], map: "alocacoes_colaborador_idx")
  @@index([conta_id])
  @@index([geracao_id, data], map: "alocacoes_geracao_data_idx")
  @@index([unidade_id], map: "alocacoes_unidade_idx")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alteracoes_pendentes {
  id             BigInt        @id @default(autoincrement())
  conta_id       String        @db.Uuid
  geracao_id     BigInt
  colaborador_id BigInt
  data           DateTime      @db.Date
  de             String        @default("")
  para           String        @default("")
  por_id         String?       @db.Uuid
  por_nome       String        @default("")
  criado_em      DateTime      @default(now()) @db.Timestamptz(6)
  colaboradores  colaboradores @relation(fields: [colaborador_id, conta_id], references: [id, conta_id], onDelete: Cascade, onUpdate: NoAction, map: "alteracoes_pendentes_colab_fk")
  contas         contas        @relation(fields: [conta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  geracoes       geracoes      @relation(fields: [geracao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  perfis         perfis?       @relation(fields: [por_id], references: [id], onUpdate: NoAction)

  @@unique([geracao_id, colaborador_id, data], map: "alteracoes_pendentes_unica")
  @@index([geracao_id], map: "alteracoes_pendentes_geracao_idx")
  @@schema("public")
}

